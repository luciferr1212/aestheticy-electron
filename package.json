{
  "name": "aestheticy",
  "private": true,
  "version": "0.1.0",
  "description": "High-performance desktop and local library music player built with Electron, React, TypeScript, Tailwind CSS, and SQLite.",
  "author": "Mido",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "electron:dev": "npm run build:electron && electron dist-electron/main/index.js",
    "build": "vite build",
    "build:electron": "esbuild electron/main/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main/index.js && esbuild electron/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.cjs",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','dist-electron','release']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win --x64",
    "build:all": "vite build && npm run build:electron"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "music-metadata": "^12.2.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/simple-peer": "^9.11.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "peerjs": "^1.5.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "simple-peer": "^9.11.1",
    "sql.js": "^1.15.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
